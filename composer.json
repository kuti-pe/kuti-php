{
  "name": "kuti-pe/kuti-php",
  "description": "SDK oficial de KUTI para PHP — crea checkout sessions, consulta pagos y verifica webhooks.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://docs.kuti.pe",
  "support": {
    "issues": "https://github.com/kuti-pe/kuti-php/issues",
    "source": "https://github.com/kuti-pe/kuti-php",
    "docs": "https://docs.kuti.pe",
    "email": "soporte@kuti.pe"
  },
  "authors": [
    {
      "name": "KUTI",
      "email": "soporte@kuti.pe",
      "homepage": "https://www.kuti.pe",
      "role": "Developer"
    }
  ],
  "keywords": [
    "kuti",
    "payments",
    "peru",
    "yape",
    "qr",
    "checkout"
  ],
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Kuti\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kuti\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
